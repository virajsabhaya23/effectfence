{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/virajsabhaya23/effectfence/schemas/mcp-manifest-v1.schema.json",
  "title": "EffectFence MCP conformance manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "server", "observers", "cases"],
  "properties": {
    "schemaVersion": {"const": "effectfence.mcp.v1"},
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "transport": {"const": "stdio"},
        "command": {"$ref": "#/$defs/command"},
        "cwd": {"type": "string"},
        "env": {"$ref": "#/$defs/stringMap"},
        "inheritEnv": {"$ref": "#/$defs/stringArray"},
        "protocolVersion": {"type": "string"},
        "requestTimeoutSeconds": {"type": "number", "exclusiveMinimum": 0},
        "startupTimeoutSeconds": {"type": "number", "exclusiveMinimum": 0},
        "maxMessageBytes": {"type": "integer", "minimum": 1024},
        "maxListPages": {"type": "integer", "minimum": 1}
      }
    },
    "observers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observer"}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumToolCoverage": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "stringMap": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {"$ref": "#/$defs/command"},
        "cwd": {"type": "string"},
        "env": {"$ref": "#/$defs/stringMap"},
        "timeoutSeconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readOnlyHint": {"type": "boolean"},
        "destructiveHint": {"type": "boolean"},
        "idempotentHint": {"type": "boolean"},
        "openWorldHint": {"type": "boolean"}
      }
    },
    "ambiguousResultFault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["drop-result-after-response", "timeout-before-send"]
        },
        "trials": {"type": "integer", "minimum": 1, "maximum": 100},
        "timeoutMs": {"type": "integer", "minimum": 1}
      }
    },
    "observer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "root"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "filesystem"},
            "root": {"type": "string"},
            "exclude": {"$ref": "#/$defs/stringArray"},
            "maxFiles": {"type": "integer", "minimum": 1},
            "maxEntries": {"type": "integer", "minimum": 1},
            "maxTotalBytes": {"type": "integer", "minimum": 1},
            "world": {"enum": ["closed", "open"]},
            "sensitive": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "database", "query"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "sqlite-query"},
            "database": {"type": "string"},
            "query": {"type": "string"},
            "parameters": {"type": "array"},
            "world": {"enum": ["closed", "open"]},
            "sensitive": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "url"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "kind": {"const": "http-json"},
            "url": {"type": "string"},
            "allowedHosts": {"$ref": "#/$defs/stringArray"},
            "headersFromEnv": {"$ref": "#/$defs/stringMap"},
            "timeoutSeconds": {"type": "number", "exclusiveMinimum": 0},
            "maxResponseBytes": {"type": "integer", "minimum": 1},
            "world": {"enum": ["closed", "open"]},
            "sensitive": {"type": "boolean"}
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tool"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "arguments": {"type": "object"},
        "observerIds": {"$ref": "#/$defs/stringArray"},
        "contract": {"$ref": "#/$defs/contract"},
        "retry": {"type": "boolean"},
        "expectToolError": {"type": "boolean"},
        "ambiguousResultFault": {"$ref": "#/$defs/ambiguousResultFault"},
        "setup": {"$ref": "#/$defs/hook"},
        "cleanup": {"$ref": "#/$defs/hook"}
      }
    }
  }
}
